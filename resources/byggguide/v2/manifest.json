        "vitest": "4.1.11"
    },
    "node": "22.x",
    "overrides": {
        "vite": "7.3.7"
    },
    "output": {
        "type": "static-export",
        "directory": "out",
        "note": "next.config.ts sets output: \"export\"; Coolify serves out/ with nginx"
    },
    "env": {
        "NEXT_PUBLIC_COMPUTERCAT_GAME": "the game slug; set as a build variable on Coolify by create_game, locally in .env.local",
        "NEXT_PUBLIC_COMPUTERCAT_URL": "optional, default https://api.computercat.co/api/v1"
    },
    "commands": {
        "install": "npm ci --ignore-scripts",
        "dev": "npm run dev",
        "test": "npm test",
        "build": "npm run build"
    },
    "required_checks": [
        {
            "name": "check",
            "command": "npm run check"
        },
        {
            "name": "audit",
            "command": "npm audit --omit=dev --audit-level=high"
        },
        {
            "name": "static_export",
            "command": "test -f out/index.html"
        }
    ],
    "steps": [
        "Write every file in files[] to its path in the repository root: delivery \"mcp\" via get_build_guide_file, delivery \"download\" via curl -fsS <download_url> -o <path>. README.md is not in the list; leave it as it is.",
        "Verify every file with sha256sum against files[].sha256. Re-fetch on mismatch; never edit a guide file by hand.",
        "Run commands.install, then every required_checks command in order. All must pass without code changes.",
        "Commit as \"Grundkod från byggguide v2\" and push directly to main. Coolify builds the Demo on that push.",
        "Follow up with get_provisioning_status until demo.state is \"live\", then build the game as described in CLAUDE.md."
    ],
