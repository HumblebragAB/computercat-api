        "framer-motion": "12.34.3",
        "next": "16.4.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "zustand": "5.0.11",
        "@tailwindcss/postcss": "4.2.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
