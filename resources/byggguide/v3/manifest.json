        "next": "16.4.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "zustand": "5.0.11",
        "@capacitor/cli": "8.5.3",
        "@tailwindcss/postcss": "4.2.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "20.19.33",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "9.39.3",
